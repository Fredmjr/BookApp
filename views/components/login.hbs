<div style="display: none;">
  {{! ................................................................Login page.................................... }}
</div>
<div class="logContainer" id="viewloginPage">
  <div class="logHeader">
    <h2>Login</h2>
  </div>
  <div class="logFormGroup">
    <label>Username or Email</label>
    <input
      type="text"
      id="emailInput"
      name="logUsername"
      placeholder="Enter your username or email"
    />
  </div>
  <div class="logFormGroup">
    <label>Password</label>
    <input
      type="password"
      id="passwordInput"
      name="logPassword"
      placeholder="Enter your password"
    />
  </div>
  <button
    type="submit"
    class="logLoginBtn"
    id="submitButton"
    onclick="authen()"
  >Login</button>
  <div class="logFooter">
    <p>Don't have an account?
      <a href="#" class="logLink" onclick="sigupPageFuc()">Sign Up</a></p>
    <p><a href="#" class="logLink">Forgot Password?</a></p>
  </div>
</div>

<div
  style="display: none;"
>{{! ...............................................................Signup Page...................................................... }}</div>

<div id="viewSiguppage" style="display: none;">
  <div class="signContainer">
    <div class="signHeader">
      <h2>Sign Up</h2>
    </div>
    <div class="signFormGroup">
      <label>Email</label>
      <input
        type="email"
        id="signEmailInput"
        name="signEmail"
        placeholder="Enter your email"
      />
    </div>
    <div class="signFormGroup">
      <label>Password</label>
      <input
        type="password"
        id="signPasswordInput"
        name="signPassword"
        placeholder="Create a password"
      />
    </div>
    <div class="signFormGroup">
      <label>Confirm Password</label>
      <input
        type="password"
        id="confSignPasswordInput"
        name="signConfirmPassword"
        placeholder="Confirm your password"
      />
    </div>
    <span id="accoungMgs"></span>
    <button
      type="submit"
      class="signRegisterBtn"
      onclick="registerNewuserFunc()"
    >Register</button>
    <div class="signFooter">
      <p>Already have an account?
        <a href="#" class="signLink" onclick="backtoLoginFuc()">Log In</a></p>
    </div>
  </div>

</div>
