            <h3>About the Author</h3>
            <p>
              Bookapp Authorship Bookapp is a curated reading platform designed
              to showcase stories from emerging and established voices around
              the world. Every book featured undergoes editorial review and is
              presented with clean typography, intuitive navigation, and
              immersive layouts optimized for digital reading.
            </p>
          </div>
        </div>

      </div></div>

    {{! ...........................Update Book......................... }}
    <div id="update-book" class="content-panel"><button
        class="close-btn"
        onclick="hidePanel()"
      >×</button><h4>Update Book</h4>
      <div>
        <div class="bookUpload-container">
          <form class="bookUpload-form" onsubmit="handleBookUpload(event)">
            <label>
              Title:
              <input type="text" name="title" required />
            </label>

            <label>
              Author:
              <input type="text" name="author" required />
            </label>

            <label>
              Genre:
              <select name="genre">
                <option>Fiction</option>
                <option>Non-Fiction</option>
                <option>Fantasy</option>
                <option>Romance</option>
                <option>Sci-Fi</option>
                <option>Biography</option>
              </select>
            </label>

            <label>
              Description:
              <textarea
                name="description"
                rows="5"
                placeholder="Brief summary or notes..."
              ></textarea>
            </label>

            <!-- Image Upload Section -->
            <label class="bookUpload-image">
              <input type="file" name="bookCover" accept="image/*" hidden />
              <div class="bookUpload-image-box">
                <span class="bookUpload-image-label">Choose Book Cover</span>
              </div>
            </label>

            <img
              id="bookUpload-preview"
              src="#"
              alt="Preview"
              style="display: none;"
            />

            <!-- Book File Upload -->
            <label>
              Upload File (PDF, DOCX only EPUB):
              <input
                type="file"
                name="bookfile"
                accept=".pdf,.doc,.docx,.epub"
                required
              />
            </label>

            <button type="submit">Submit Book</button>
          </form>

          <div id="uploadStatus"></div>
        </div>

      </div></div>

