<div
  class="book-card"
  onclick="bookContFunc()"
  data-id="{{this.dataValues.id}}"
>
  <div class="imgCard">
    <div class="imgClass">
      <img src="/imgs/bookexamplecover.png" alt="Book Cover" />
    </div></div>
  <h2 class="book-title" aria-placeholder="Empty Title">{{title}}</h2>
  <p class="book-author">Lorem ipsum dolor sit amet consectetur adipisicing
    elit. Sint, facere?
  </p>
  <div class="price_rates">
    <span class="price">K00.00</span>
    <div class="ratesSlot">
      <div class="rates">
        <img src="/imgs/star.png" alt="ratings" />
        <img src="/imgs/star.png" alt="ratings" />
        <img src="/imgs/star.png" alt="ratings" />
        <img src="/imgs/star.png" alt="ratings" />
        <img src="/imgs/star.png" alt="ratings" />
      </div>
    </div>
  </div>
  {{!   <button class="buyBtn">Buy</button> }}
</div>